<script src="https://unpkg.com/typewriter-effect@2.19.0/dist/core.js"></script>

    <style>
    
      body {
        background-color: black;
        margin: 0;
      }
      img {
        
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
      }

      .container {
        width: 100%;
        height: 100%;
        background-image: url('typewriter.jpg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center center;
        text-align: center;
      }
      
      #text {
        background-color: black;
        color: white;
        position: relative;
        top: 90%;
        font-size: 150%;
        padding-left: 6px;
      }
    </style> 


    <body>
      <div class="container">
        <span id="text"></span>
      </div>

        
    <script>
        var app = document.getElementById('text');
        var typewriter = new Typewriter(app, {});
        typewriter.typeString(`<%= desc.normalize() %>`);
        typewriter.start();
    </script>
    
    
    </body>